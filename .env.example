# Everyone needs this one key. Powers everything - questions, summaries,
# captions, and image descriptions, all through OpenRouter's default model.
# Get one at openrouter.ai/keys.
OPENROUTER_API_KEY=sk-or-your-key-here

# Optional: which OpenRouter model to use (must accept images). Defaults to
# google/gemini-3.7-flash; failed requests retry on a backup model automatically.
# OPENROUTER_MODEL=anthropic/claude-haiku-5.5
