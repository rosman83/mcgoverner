# Everyone needs this one key. Powers everything - questions, summaries,
# captions, and image descriptions, all through OpenRouter's default model.
# Get one at openrouter.ai/keys.
OPENROUTER_API_KEY=sk-or-your-key-here

# Optional: which OpenRouter model to use (must accept images). Defaults to
# google/gemini-3.7-flash; failed requests retry on a backup model automatically.
# OPENROUTER_MODEL=anthropic/claude-haiku-5.5

# Advanced, optional: if you already have DeepSeek credit, this uses it for
# text generation (questions/summaries/captions) instead of OpenRouter - image
# descriptions still always use OpenRouter, DeepSeek has no vision model.
# Both lines are required together; leave both commented out to just use
# OpenRouter for everything (recommended for most people).
# USE_DEEPSEEK_FOR_TEXT=true
# DEEPSEEK_API_KEY=sk-your-deepseek-key-here
