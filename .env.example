# Text generation: DeepSeek is billed direct.
LLM_PROVIDER=deepseek

DEEPSEEK_API_KEY=sk-your-key-here

# Optional overrides:
# LLM_MODEL=deepseek-chat
# LLM_BASE_URL=https://api.deepseek.com

# OpenRouter: one key for everything that isn't DeepSeek direct - an alternate text
# provider (LLM_PROVIDER=openrouter) and the vision fallback below.
#
# Vision fallback: slides with images but little/no OCR text (research figures,
# anatomy diagrams) get described by an OpenRouter vision model, independent of
# LLM_PROVIDER above. Set this even if your text provider is DeepSeek, or those
# slides stay thin.
OPENROUTER_API_KEY=sk-or-your-key-here
# OPENROUTER_VISION_MODEL=google/gemini-2.0-flash-001
